# Copy to .env and edit. Docker Compose reads .env automatically for the
# ${VAR:-default} interpolation in docker-compose.yml.
#
# .env is gitignored. For production prefer the *_FILE variables with Docker
# secrets over plaintext values here: env-var passwords are visible in
# `docker inspect`, `ps` and orchestrator manifests.

LDAP_DOMAIN=example.com
LDAP_ORGANIZATION=Example Organization

LDAP_ADMIN_PASSWORD=changeme
LDAP_CONFIG_PASSWORD=changeme
# LDAP_ADMIN_PASSWORD_FILE=/run/secrets/ldap_admin_password
# LDAP_CONFIG_PASSWORD_FILE=/run/secrets/ldap_config_password

# --- Features -----------------------------------------------------------------
ENABLE_MONITORING=true
ENABLE_MEMBEROF=false
ENABLE_PASSWORD_POLICY=false
ENABLE_AUDIT_LOG=false
# INCLUDE_SCHEMAS=cosine,inetorgperson,nis
# LDAP_LOG_LEVEL=16640          # 256=stats, 16384=sync; replication defaults to 16640

# --- TLS ----------------------------------------------------------------------
# LDAP_TLS_CERT=/etc/certs/ldap.crt
# LDAP_TLS_KEY=/etc/certs/ldap.key
# LDAP_TLS_CA=/etc/certs/ca.crt
# LDAP_TLS_VERIFY_CLIENT=never  # never|allow|try|demand
# LDAP_TLS_PROTOCOL_MIN=3.3     # 3.3 = TLS 1.2
# LDAP_TLS_CIPHER_SUITE=        # empty = OpenSSL default

# --- Multi-master replication -------------------------------------------------
# See docker-compose.replication.yml in the openldap-usecases repository for a
# complete 3-node mesh.
#
# ENABLE_REPLICATION=true
# SERVER_ID=1
#   Must be set EXPLICITLY and be unique per node. With replication enabled the
#   container refuses to start if SERVER_ID is left at its default, because two
#   nodes sharing a serverID write CSNs with the same sid and corrupt
#   replication ordering.
# REPLICATION_PEERS=openldap-node2,openldap-node3
#   Must NOT name this node - that is a replication loop and is rejected.
# REPLICATION_SERVER_IDS=1=ldap://openldap-node1:389,2=ldap://openldap-node2:389,3=ldap://openldap-node3:389
#   Full SID->URL map, applied on every node (the N-Way form from the OpenLDAP
#   2.6 Administrator's Guide). Optional; without it only this node's SID is set.
# LDAP_REPLICATION_PASSWORD=change-me
#   Creates cn=replicator,<base> and uses it for syncrepl instead of the
#   directory rootDN. Strongly recommended. Without it replication binds as the
#   rootDN and stores the administrator password in cleartext in cn=config.
# LDAP_REPLICATION_STARTTLS=critical
#   Adds starttls=critical to every olcSyncRepl. Without it the bind password
#   crosses the network in cleartext even if TLS is configured for clients.
# LDAP_REPLICATION_TLS_REQCERT=demand   # demand|allow|never

# --- Access control and limits ------------------------------------------------
# LDAP_READ_ACCESS_SUBJECT=users
#   "users" = any authenticated principal may read the whole directory. Restrict
#   with a group selector, e.g.
#   group.exact="cn=ldap-readers,ou=Group,dc=example,dc=com"
# LDAP_QUERY_SIZE_SOFT=500
# LDAP_QUERY_SIZE_HARD=1000
#   NOTE: any bind that is neither the rootDN nor a service account is silently
#   truncated at LDAP_QUERY_SIZE_HARD. Clients must use RFC 2696 paged results.
#   cn=replicator and cn=monitor are exempted automatically.
# LDAP_DISABLE_ANONYMOUS_BIND=false
# LDAP_THREADS=16
# LDAP_PASSWORD_HASH={SSHA}
