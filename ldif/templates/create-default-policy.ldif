# Create the default password policy entry.
# Variables: LDAP_BASE_DN
#
# The parent ou=Policies is created separately by create-policies-ou.ldif.
#
# pwdMinLength is enforced without any check module. pwdCheckQuality: 1 means
# "check quality if possible, otherwise accept": with no olcPPolicyCheckModule
# configured (none is available in the base package) the quality checks beyond
# length are inert. Setting pwdCheckQuality: 2 without a check module would
# reject every password, so 1 is deliberate. See README "Password Policy".
dn: cn=default,ou=Policies,{{LDAP_BASE_DN}}
objectClass: pwdPolicy
objectClass: person
cn: default
sn: default
pwdAttribute: userPassword
pwdMinAge: 0
pwdMaxAge: 7776000
pwdInHistory: 5
pwdCheckQuality: 1
pwdMinLength: 8
pwdExpireWarning: 1209600
pwdGraceAuthNLimit: 0
pwdLockout: TRUE
pwdLockoutDuration: 1800
pwdMaxFailure: 5
pwdFailureCountInterval: 1800
pwdMustChange: TRUE
pwdAllowUserChange: TRUE
pwdSafeModify: FALSE
