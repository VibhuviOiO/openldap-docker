# Create a dedicated service (bind) account.
# Variables: ACCOUNT_CN, ACCOUNT_DESCRIPTION, ACCOUNT_HASH, LDAP_BASE_DN
#
# simpleSecurityObject is what permits userPassword on an organizationalRole
# entry. These accounts are exempted from olcLimits in set-limits.ldif - a
# replication account that is subject to size.hard builds a PARTIAL replica
# silently, because syncrepl is subject to the limits of its bind identity.
dn: cn={{ACCOUNT_CN}},{{LDAP_BASE_DN}}
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: {{ACCOUNT_CN}}
description: {{ACCOUNT_DESCRIPTION}}
userPassword: {{ACCOUNT_HASH}}
