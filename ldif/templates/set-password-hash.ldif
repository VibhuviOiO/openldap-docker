# Set the password hashing scheme used when a cleartext password is supplied.
# Variables: PASSWORD_HASH
#
# {SSHA} is the OpenLDAP default. It is salted but SHA-1 based and therefore
# weak by current standards; it is kept as the default only because it is
# guaranteed to be available. {ARGON2} requires the argon2 contrib module to be
# present in the build - setting a scheme whose module is missing will reject
# password writes.
dn: cn=config
changetype: modify
replace: olcPasswordHash
olcPasswordHash: {{PASSWORD_HASH}}
